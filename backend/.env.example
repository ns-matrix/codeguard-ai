# Copy to backend/.env and fill in values.

# --- Database ---
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/code_validator
#
# Supabase Session pooler (Project Settings → Database → Connection string → Session pooler):
#   - Username is postgres.<project-ref> (not bare postgres)
#   - Region must match your project (example below uses ap-south-1)
#   - Use ssl=disable only if TLS is blocked on your network
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=disable
# Direct host (db.<ref>.supabase.co) is often IPv6-only and may not resolve on IPv4-only networks.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_validator

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1:7b-fast
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=4096

# --- App ---
DEBUG=false

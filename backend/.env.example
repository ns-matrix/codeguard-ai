# Copy to backend/.env and fill in values.

# --- Database ---
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/code_validator
#
# Supabase (Project Settings → Database → Connection string → URI, Session mode):
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SSL is enabled automatically for supabase.co / amazonaws.com hosts.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_validator

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=deepseek-r1:7b-fast
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=4096

# --- App ---
DEBUG=false
